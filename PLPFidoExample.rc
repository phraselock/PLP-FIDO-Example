/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_PLPFIDOEXAMPLE_DIALOG DIALOGEX 0, 0, 340, 290
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "PLP FIDO Example (libfido2)"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Authenticator",IDC_STATIC,7,7,326,100
    LTEXT           "Device:",IDC_STATIC,14,22,40,8
    COMBOBOX        IDC_COMBO_DEVICE,58,20,210,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Refresh",IDC_BTN_REFRESH,274,19,52,14
    LTEXT           "RP ID:",IDC_STATIC,14,40,40,8
    EDITTEXT        IDC_EDIT_RPID,58,37,120,14,ES_AUTOHSCROLL
    LTEXT           "User:",IDC_STATIC,188,40,24,8
    EDITTEXT        IDC_EDIT_USER,214,37,112,14,ES_AUTOHSCROLL
    LTEXT           "PIN:",IDC_STATIC,14,58,40,8
    EDITTEXT        IDC_EDIT_PIN,58,55,80,14,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "(optional, USB keys only - Windows Hello asks itself)",IDC_STATIC,144,58,182,8
    CONTROL         "Discoverable credential (passkey / resident key)",IDC_CHECK_RK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,58,75,200,10
    CONTROL         "windows://hello: security keys only (no Windows Hello)",IDC_CHECK_ROAMING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,58,89,260,10
    PUSHBUTTON      "Device Info",IDC_BTN_INFO,7,114,60,16
    PUSHBUTTON      "Register",IDC_BTN_REGISTER,71,114,60,16
    PUSHBUTTON      "Sign In",IDC_BTN_SIGNIN,135,114,60,16
    PUSHBUTTON      "Clear Log",IDC_BTN_CLEAR,199,114,60,16
    PUSHBUTTON      "Close",IDCANCEL,273,114,60,16
    EDITTEXT        IDC_EDIT_LOG,7,136,326,147,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
END


