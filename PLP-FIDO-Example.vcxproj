    <ClCompile Include="FidoDemo.cpp" />
    <ClCompile Include="WinWebAuthn.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="PLPFidoExample.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="vcpkg.json" />
    <None Include="README.md" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
